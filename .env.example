# ═══════════════════════════════════════════════════════════════
# hapo-ai-hub Docker Deployment Configuration
# ═══════════════════════════════════════════════════════════════
#
# Usage:
#   1. cp .env.example .env
#   2. Fill in all values below
#   3. ./scripts/deploy.sh
#
# Generate secrets:
#   openssl rand -base64 24
#   openssl rand -base64 32
#
# ═══════════════════════════════════════════════════════════════

# ─── Domain & SSL ──────────────────────────────────────────────
# Domain phải trỏ A record về IP server trước khi deploy
# SSL sẽ được tự động cấu hình qua Let's Encrypt
DOMAIN=partner.example.com
CERTBOT_EMAIL=admin@partner.example.com

# ─── MySQL ─────────────────────────────────────────────────────
# Database credentials
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=api_gateway
MYSQL_PASSWORD=change-me-db-password

# ─── Go Gateway ────────────────────────────────────────────────
# Gateway runtime config
GO_GATEWAY_ENV=production
GO_GATEWAY_PORT=18080

# JWT secret (tối thiểu 32 ký tự)
GO_GATEWAY_AUTH_JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# Admin token cho cutover API
GO_GATEWAY_CUTOVER_ADMIN_TOKEN=change-me-cutover-token

# Timeouts (giây)
GO_GATEWAY_AUTH_ACCESS_EXPIRE_SECONDS=1800
GO_GATEWAY_READ_TIMEOUT_SECONDS=15
GO_GATEWAY_READ_HEADER_TIMEOUT_SECONDS=10
GO_GATEWAY_WRITE_TIMEOUT_SECONDS=7200
GO_GATEWAY_IDLE_TIMEOUT_SECONDS=60

# ─── CLIProxyAPI ───────────────────────────────────────────────
# Cliproxy credentials
CLIPROXY_API_KEY=change-me-cliproxy-api-key
CLIPROXY_MANAGEMENT_SECRET=change-me-management-secret

# Internal URLs (không cần thay đổi)
GO_GATEWAY_CLIPROXY_EXECUTION_BASE_URL=http://cliproxy:8317
GO_GATEWAY_CLIPROXY_EXECUTION_API_KEY=${CLIPROXY_API_KEY}
GO_GATEWAY_CLIPROXY_MANAGEMENT_BASE_URL=http://cliproxy:8317
GO_GATEWAY_CLIPROXY_MANAGEMENT_AUTH=${CLIPROXY_MANAGEMENT_SECRET}

# ─── Provider API Keys (optional) ─────────────────────────────
# OpenRouter API key (nếu dùng OpenRouter provider)
OPENROUTER_API_KEY=

# ─── Server Tool Providers ─────────────────────────────────────
# Web search provider: "you" hoặc "brave"
WEB_SEARCH_PROVIDER=you
WEB_SEARCH_MAX_RESULTS=5

# API keys cho web search providers
YOU_API_KEY=
BRAVE_API_KEY=

# Max content tokens cho web fetch
WEB_FETCH_MAX_CONTENT_TOKENS=50000

# ─── Admin Account ────────────────────────────────────────────
# Tài khoản admin đầu tiên (được tạo tự động khi deploy)
ADMIN_EMAIL=admin@partner.example.com
ADMIN_PASSWORD=change-me-admin-password

# ─── Image Versions ───────────────────────────────────────────
# GHCR owner (GitHub username hoặc org)
GHCR_OWNER=hapo-nghialuu

# Docker image versions
GATEWAY_VERSION=latest
PORTAL_VERSION=latest
CLIPROXY_VERSION=latest

# ─── GitHub Token (for GHCR login) ────────────────────────────
# Tạo tại: https://github.com/settings/tokens
# Scope: read:packages
GHCR_TOKEN=change-me-github-token
